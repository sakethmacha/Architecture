@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="text-center">

        <div class="card shadow-lg p-5" style="border-radius: 16px; width: 420px;">
            <div class="mb-3">
                <i class="bi bi-shield-lock-fill" style="font-size: 4rem; color: #dc3545;"></i>
            </div>

            <h2 class="fw-bold text-danger">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have permission to view this page.
            </p>

            <a href="/" class="btn btn-primary w-100 mb-2">Go to Home</a>
            <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary w-100">Login with another account</a>
        </div>
    </div>
</div>
