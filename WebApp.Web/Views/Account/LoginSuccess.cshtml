@using System.Security.Claims

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 text-center" style="width: 480px;">

        <i class="fa-solid fa-circle-check fa-4x text-success mb-3"></i>

        <h2 class="mb-2">Login Successful</h2>
        <p class="text-muted mb-4">
            You have successfully logged into the system
        </p>

        <hr />

        <p class="mb-1">
            <strong>User:</strong> @User.Identity?.Name
        </p>

        <p class="mb-3">
            <strong>Role:</strong>
            @User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value
        </p>

        <div class="d-grid gap-2">

            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </div>
    </div>
</div>
