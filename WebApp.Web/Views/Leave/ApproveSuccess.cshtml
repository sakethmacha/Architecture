@{
    ViewData["Title"] = "Leave Approved";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 text-center">
        <div class="card-body p-5">
            <div class="mb-3">
                <span class="display-1 text-success">✔</span>
            </div>

            <h2 class="text-success mb-3">Leave Approved</h2>

            <p class="text-muted mb-4">
                The leave request has been approved successfully.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Pending" class="btn btn-primary">
                    Back to Pending Requests
                </a>

            </div>
        </div>
    </div>
</div>
